# Supabase Cloud Environment Variables for Project: gyrzipnfnxvccakeejky
PORT=5000
NODE_ENV=production

# Supabase Cloud Backend
SUPABASE_URL=https://gyrzipnfnxvccakeejky.supabase.co
# Isi dengan Service Role Key dari Supabase Dashboard > Project Settings > API:
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT Secret
JWT_SECRET=noize-super-secret-jwt-token-with-at-least-32-characters-long

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile (Opsional)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

