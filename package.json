{
  "name": "noize-workspace",
  "version": "1.0.0",
  "description": "Monorepo for Noize Official Website",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "api"
  ],
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../api && npm install",
    "install:all:pnpm": "pnpm install && cd frontend && pnpm install && cd ../backend && pnpm install && cd ../api && pnpm install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend:pnpm": "cd frontend && pnpm run dev",
    "dev:backend:pnpm": "cd backend && pnpm run dev",
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:pnpm": "concurrently --names \"API,WEB\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others-on-fail \"pnpm run dev:backend:pnpm\" \"pnpm run dev:frontend:pnpm\"",
    "start": "npm run dev",
    "build": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test": "cd backend && node --test tests/*.test.js",
    "start:backend": "cd backend && npm start",
    "vercel-build": "npm run build"
  },
  "keywords": [
    "noize",
    "cheki",
    "idol",
    "music"
  ],
  "author": "Noize",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supabase": "^2.117.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sharp",
      "esbuild",
      "core-js",
      "@supabase/cli-windows-x64"
    ]
  }
}
